{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=BazingoDb;Trusted_Connection=True;TrustServerCertificate=true;",
    "IdentityConnection": "Server=.;Database=BazingoIdentityDb;Trusted_Connection=True;TrustServerCertificate=true;"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecureKeyHere",
    "Issuer": "BazingoIssuer",
    "Audience": "BazingoAudience",
    "TokenLifetime": "3600" // in seconds
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"

}